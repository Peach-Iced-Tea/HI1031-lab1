<% if (session.getAttribute("userId") == null) { %>
    <%
        String modalNext =
                "checkout".equals(request.getParameter("next"))
                ? "checkout" : "products";

        String modalError = null;
        String modalErrorCode = request.getParameter("loginError");

        if ("invalid".equals(modalErrorCode)) {
            modalError = "Incorrect username or password.";
        } else if ("unavailable".equals(modalErrorCode)) {
            modalError = "Login is temporarily unavailable. Please try again.";
        }
    %>

    <dialog id="login-modal" class="login-modal"
            aria-labelledby="login-modal-title">

        <div class="login-modal-header">
            <span class="eyebrow">YOUR ACCOUNT</span>

            <button type="button" id="close-login"
                    class="button button-secondary">
                Close
            </button>
        </div>

        <h2 id="login-modal-title">Welcome back.</h2>

        <p class="login-description">
            Log in to continue. Your shopping cart stays with you.
        </p>

        <% if (modalError != null) { %>
            <p class="notice notice-error" role="alert">
                <%= modalError %>
            </p>
        <% } %>

        <form action="login.jsp" method="post" class="login-form">
            <input type="hidden" name="token" value="<%= cartToken %>">
            <input type="hidden" name="next" value="<%= modalNext %>">
            <input type="hidden" name="presentation" value="modal">

            <label>
                Username
                <input type="text" name="username"
                       autocomplete="username"
                       maxlength="50" required autofocus>
            </label>

            <label>
                Password
                <input type="password" name="password"
                       autocomplete="current-password"
                       maxlength="256" required>
            </label>

            <button type="submit" class="button button-primary">
                Log in
            </button>
        </form>

        <p class="login-note">
            Just browsing? You can keep shopping without an account.
        </p>
    </dialog>
<% } %>