<jsp:useBean id="cartService"
             class="se.kth.webshop.service.CartService"
             scope="session" />

<%
    se.kth.webshop.dto.CartDTO cartView = cartService.getSnapshot();

    String cartToken;

    synchronized (session) {
        cartToken = (String) session.getAttribute("cartToken");

        if (cartToken == null) {
            cartToken = java.util.UUID.randomUUID().toString();
            session.setAttribute("cartToken", cartToken);
        }
    }
%>